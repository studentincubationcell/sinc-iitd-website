# Local SQLite (path relative to prisma/schema.prisma)
DATABASE_URL="file:../.data/registry.db"

# Production: Neon / Vercel Postgres (postgresql://…). The build script
# switches Prisma to postgresql when DATABASE_URL starts with postgres.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sinc?sslmode=require"

# Coordinator passcode for viewing registry submissions (View registry tab)
REGISTRY_PASSCODE="change-me"

# Public site URL used in confirmation emails
SITE_URL="http://localhost:3000"

# SMTP — confirmation emails to founders who list on /registry
# Gmail (studentincubationcell@gmail.com): see docs/REGISTRY_DB.md
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SInC IIT Delhi <studentincubationcell@gmail.com>"
SMTP_REPLY_TO="studentincubationcell@gmail.com"

# BCC so coordinators get a copy of every listing
REGISTRY_NOTIFY_EMAIL="studentincubationcell@gmail.com"
