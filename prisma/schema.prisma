generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local: sqlite. Production build copies this to schema.runtime.prisma
  // with provider = postgresql when DATABASE_URL starts with postgres.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// SInC Startup Registry listing — mentors / coordinators review these.
model RegistryEntry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  venture   String
  pitch     String
  stage     String
  sector    String
  link      String?
  referral  String?
  /// Optional deep profile JSON: problem, solution, funds, deck, revenue, future
  deepJson  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}
